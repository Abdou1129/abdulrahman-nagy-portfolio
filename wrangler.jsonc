{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abdulrahman-nagy",
  "compatibility_date": "2026-09-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "site"
  },
  "routes": [
    { "pattern": "nagy-media.de", "custom_domain": true },
    { "pattern": "www.nagy-media.de", "custom_domain": true }
  ]
}
